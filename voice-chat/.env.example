# Kopiere diese Datei zu ".env.local" und trage deine Keys ein.

# === Claude (Pflicht) ======================================================
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: anderes Modell (Standard: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# === Natürliche Sprachausgabe (empfohlen) ==================================
# Setze EINEN der beiden Anbieter. Ist keiner gesetzt, nutzt die App die
# (einfachere) Browserstimme. Mit TTS_PROVIDER kannst du bei Bedarf erzwingen,
# welcher Anbieter genutzt wird.
# TTS_PROVIDER=elevenlabs   # oder: openai

# --- ElevenLabs (natürlichste Stimmen) -------------------------------------
# Key: https://elevenlabs.io  ->  Profil -> API Keys
# ELEVENLABS_API_KEY=...
# Stimme aus deiner ElevenLabs-Bibliothek (Standard: "Sarah", mehrsprachig):
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Modell: eleven_turbo_v2_5 (schnell) oder eleven_multilingual_v2 (Qualität)
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- OpenAI TTS (sehr natürlich, günstiger) --------------------------------
# Key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# Stimme: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer
# OPENAI_TTS_VOICE=shimmer
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Ton-Anweisung (nur gpt-4o-mini-tts):
# OPENAI_TTS_INSTRUCTIONS=Sprich locker und natürlich auf Deutsch, warm und mit lebendiger Betonung.
